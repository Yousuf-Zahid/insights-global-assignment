# Every setting is optional. Copy to .env only to override a default.

# Defaults to backend/insights.db (resolved from the source tree, not the working directory)
# DATABASE_URL=sqlite:///C:/absolute/path/to/insights.db

# Comma-separated list of allowed browser origins
# CORS_ORIGINS=http://localhost:5173

# DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
